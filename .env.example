# ==============================================================
# Student Skill Exchange Platform - Environment Configuration
# ==============================================================

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-key
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Database Configuration
# Default development fallback: SQLite
DATABASE_URL=sqlite:///skill_exchange.db
# MySQL Example for production/college lab:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/skill_exchange_db

# CORS Configuration (Restricted frontend origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay Payment Gateway Credentials (Test Mode for Development)
# Replace with your Razorpay Test API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key
RAZORPAY_CURRENCY=INR

# Platform Admin Seed Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@campusskills.edu
ADMIN_PASSWORD=AdminSecurePass123!
